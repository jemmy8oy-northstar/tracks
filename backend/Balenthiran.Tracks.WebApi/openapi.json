{
  "openapi": "3.1.1",
  "info": {
    "title": "Balenthiran.Tracks.WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "Balenthiran.Tracks.WebApi"
        ],
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/workouts": {
      "get": {
        "tags": [
          "WorkoutRoutes"
        ],
        "operationId": "ListWorkouts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IWorkoutSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workouts/{id}": {
      "get": {
        "tags": [
          "WorkoutRoutes"
        ],
        "operationId": "GetWorkoutMap",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IMusicMap"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IMusicMap": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "hasRoute": {
            "type": "boolean"
          },
          "route": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IRoutePoint"
            }
          },
          "songs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ISongPin"
            }
          }
        }
      },
      "IRoutePoint": {
        "type": "object",
        "properties": {
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ISongPin": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "coverColour": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "elapsedSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "distanceMetres": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "pin": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IRoutePoint"
              }
            ]
          }
        }
      },
      "IWorkoutSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "hasRoute": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Balenthiran.Tracks.WebApi"
    },
    {
      "name": "WorkoutRoutes"
    }
  ]
}