{
  "openapi": "3.1.1",
  "info": {
    "title": "Balenthiran.Tracks.WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "Balenthiran.Tracks.WebApi"
        ],
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/strava": {
      "get": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "StartStravaSignIn",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/strava/callback": {
      "get": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "FinishStravaSignIn",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "SignOut",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/spotify": {
      "get": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "StartSpotifyConnect",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "DisconnectSpotify",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/spotify/callback": {
      "get": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "FinishSpotifyConnect",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "AuthRoutes"
        ],
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/strava/webhook": {
      "get": {
        "tags": [
          "StravaRoutes"
        ],
        "operationId": "VerifyStravaWebhook",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "StravaRoutes"
        ],
        "operationId": "ReceiveStravaWebhookEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StravaWebhookEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "tags": [
          "RunsRoutes"
        ],
        "operationId": "GetRuns",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/upload": {
      "post": {
        "tags": [
          "RunsRoutes"
        ],
        "operationId": "UploadRun",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "MeResponse": {
        "required": [
          "athleteId",
          "spotifyConnected"
        ],
        "type": "object",
        "properties": {
          "athleteId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "spotifyConnected": {
            "type": "boolean"
          }
        }
      },
      "RunResponse": {
        "required": [
          "activityId",
          "name",
          "sportType",
          "startedAt",
          "elapsedSeconds",
          "songs",
          "contextType",
          "contextName",
          "route"
        ],
        "type": "object",
        "properties": {
          "activityId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "sportType": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "elapsedSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "songs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunSongResponse"
            }
          },
          "contextType": {
            "type": [
              "null",
              "string"
            ]
          },
          "contextName": {
            "type": [
              "null",
              "string"
            ]
          },
          "route": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                "type": [
                  "number",
                  "string"
                ],
                "format": "double"
              }
            }
          }
        }
      },
      "RunSongResponse": {
        "required": [
          "name",
          "artists",
          "albumArtUrl",
          "playedAt",
          "offsetSeconds",
          "isTopSpeed",
          "isFastestPace",
          "routeIndex",
          "distanceMetres"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "albumArtUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "playedAt": {
            "type": "string",
            "format": "date-time"
          },
          "offsetSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isTopSpeed": {
            "type": "boolean"
          },
          "isFastestPace": {
            "type": "boolean"
          },
          "routeIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "distanceMetres": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "StravaWebhookEvent": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": [
              "null",
              "string"
            ]
          },
          "object_id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "aspect_type": {
            "type": [
              "null",
              "string"
            ]
          },
          "owner_id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "updates": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Balenthiran.Tracks.WebApi"
    },
    {
      "name": "AuthRoutes"
    },
    {
      "name": "StravaRoutes"
    },
    {
      "name": "RunsRoutes"
    }
  ]
}